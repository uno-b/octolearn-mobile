{
  "expo": {
    "name": "OctoLearn",
    "slug": "octolearn",
    "scheme": "octolearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.unob.octolearn",
      "supportsTablet": false
    },
    "android": {
      "package": "com.unob.octolearn",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E7C9B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C9B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7a8a1d42-8ae9-457e-86a2-a858ddb8da25"
      }
    },
    "owner": "kengeek"
  }
}
